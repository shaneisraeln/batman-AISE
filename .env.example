# =============================================================================
# BATMAN configuration — copy to .env and fill in. NEVER commit the real .env
# (it is gitignored). All values have safe defaults; the system runs locally
# with a stub LLM, lightweight embeddings, and SQLite when nothing is set.
#
# This single file documents BOTH the Phase 1 engine settings and the Phase 2
# cloud / multi-tenant settings. For a containerized cloud deployment see also
# .env.cloud.example (Postgres + Caddy + compose wiring) and docs/DEPLOYMENT.md.
#
# Placeholders below are EXAMPLES ONLY — replace them with your own values.
# =============================================================================

# --- Environment mode -------------------------------------------------------
# development | staging | production. In production/staging the app logs
# advisory warnings if secrets/CORS/DB look unsafe (see batman/cloud/prodcheck).
BATMAN_ENV=development

# --- General engine ---------------------------------------------------------
BATMAN_MODE=enforce            # monitor | enforce
BATMAN_LOG_LEVEL=INFO
# Path to the calibrated anomaly detector. The cloud Docker image builds this
# at image time; locally, train it or point at models/isolation_forest*.joblib.
BATMAN_DETECTOR_PATH=models/isolation_forest.joblib

# =============================================================================
# CLOUD (Phase 2) — control plane + multi-tenant data plane
# =============================================================================

# --- Database ---------------------------------------------------------------
# Local dev default is SQLite. Production MUST use PostgreSQL.
#   sqlite:///batman.db
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
BATMAN_DATABASE_URL=sqlite:///batman.db

# --- Session token signing (REQUIRED in production) -------------------------
# Long random string used to sign stateless HMAC session tokens. If unset, a
# known insecure dev default is used (fine for local only). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BATMAN_SECRET_KEY=change-me-long-random-string

# --- Upstream credential encryption (REQUIRED to store upstream secrets) -----
# Fernet key. If unset, storing an upstream auth secret FAILS CLOSED (503) —
# it will never be written in plaintext. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BATMAN_ENCRYPTION_KEY=change-me-fernet-key

# --- CORS (browser origins allowed to call the API) -------------------------
# Comma-separated, no trailing slash. NEVER "*" (the API is token-bearing).
# Dev default below; in production set your real dashboard origin(s), e.g.
#   https://app.batman.example
BATMAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Public domain + HTTPS (Caddy; used by the cloud compose stack) ---------
# Leave as :80 for local HTTP. Set to your domain for automatic Let's Encrypt.
BATMAN_SITE_ADDRESS=:80

# --- SSRF guard for upstream model URLs -------------------------------------
# The upstream URL a tenant registers is validated: loopback / private /
# link-local / cloud-metadata addresses are BLOCKED by default. Set to 1 ONLY
# for local dev / docker where your protected model is on a trusted private
# network (e.g. the bundled ml-service). Keep OFF in production.
BATMAN_ALLOW_PRIVATE_UPSTREAM=0

# --- Data-plane request-size bounds (resource-exhaustion guard) -------------
BATMAN_MAX_PREDICT_ROWS=1000
BATMAN_MAX_PREDICT_COLS=4096

# --- Rate limiting (per-key sliding window for /v1/predict) -----------------
# NOTE: the limiter is in-memory per process. For multi-instance deployments
# add a shared limiter (Redis) or an edge rate limiter at the proxy.
BATMAN_RL_RPM=60
BATMAN_RL_BURST=10

# =============================================================================
# LLM provider (optional; stub works with no external service)
# =============================================================================
# Options: stub | groq | bedrock
BATMAN_LLM_PROVIDER=stub

# --- Groq (free tier; recommended for MVP) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Amazon Bedrock (optional) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# AWS credentials are read from the standard AWS credential chain.

# =============================================================================
# RAG / embeddings
# =============================================================================
BATMAN_EMBEDDINGS_BACKEND=hashing        # hashing (default, no heavy deps) | sentence_transformers
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2
BATMAN_VECTOR_STORE=memory               # memory (default) | chroma

# =============================================================================
# Environment separation cheat-sheet
# =============================================================================
# DEVELOPMENT (local):
#   BATMAN_ENV=development, SQLite, stub LLM, CORS localhost, dev secret OK,
#   BATMAN_ALLOW_PRIVATE_UPSTREAM=1 (to reach a local ml-service).
# STAGING / PRODUCTION:
#   BATMAN_ENV=production, PostgreSQL BATMAN_DATABASE_URL, strong unique
#   BATMAN_SECRET_KEY + BATMAN_ENCRYPTION_KEY, real BATMAN_CORS_ORIGINS,
#   BATMAN_SITE_ADDRESS=your.domain, BATMAN_ALLOW_PRIVATE_UPSTREAM=0.
#   Never reuse development secrets or a demo database in production.
