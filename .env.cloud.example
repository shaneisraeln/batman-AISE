# BATMAN Cloud deployment secrets. Copy to .env and fill with STRONG values.
# NEVER commit the real .env (it is gitignored).

# --- PostgreSQL ---
POSTGRES_USER=batman
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=batman

# --- Auth / tokens ---
# Long random string used to sign session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BATMAN_SECRET_KEY=change-me-long-random-string

# --- Upstream credential encryption (Fernet) ---
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BATMAN_ENCRYPTION_KEY=change-me-fernet-key

# --- LLM (optional; stub works with no external service) ---
BATMAN_LLM_PROVIDER=stub
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Public domain + HTTPS (Caddy) ---
# Leave unset (or ":80") for local HTTP testing. Set to your real domain to
# have Caddy automatically provision + renew Let's Encrypt TLS and serve HTTPS.
#   BATMAN_SITE_ADDRESS=batman.example.com
BATMAN_SITE_ADDRESS=:80

# --- CORS (browser origins allowed to call the API) ---
# Not needed when the dashboard is served same-origin behind Caddy. If you host
# the dashboard on a separate origin, list it here (comma-separated, no
# trailing slash), e.g. https://app.batman.example
BATMAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
