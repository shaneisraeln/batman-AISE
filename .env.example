# BATMAN configuration. Copy to .env and fill in as needed.
# All values are optional; the system runs with a stub LLM and lightweight
# embeddings when nothing is configured.

# --- General ---
BATMAN_DB_PATH=batman.db
BATMAN_MODE=enforce            # monitor | enforce
BATMAN_LOG_LEVEL=INFO

# --- LLM provider selection ---
# Options: stub | groq | bedrock
# Set to `groq` (and fill GROQ_API_KEY) to enable real LLM threat explanations.
BATMAN_LLM_PROVIDER=stub

# --- Groq (free, recommended for MVP) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Amazon Bedrock (optional) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# AWS credentials are read from the standard AWS credential chain.

# --- RAG / embeddings ---
# Embeddings backend: hashing (default, no heavy deps) | sentence_transformers
BATMAN_EMBEDDINGS_BACKEND=hashing
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2
# Vector store: memory (default) | chroma
BATMAN_VECTOR_STORE=memory
